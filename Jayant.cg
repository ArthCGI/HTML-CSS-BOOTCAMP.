import os
import subprocess
import sys
from getpass import getpass

# Load password from environment variable
PASSWORD = os.getenv("APP_PASSWORD", "default_password")

def calculate_sum(numbers):
    return sum(numbers)

def login(username, user_password):
    return username == "admin" and user_password == PASSWORD

def execute_command(user_input):
    # Define a whitelist of allowed commands
    allowed_commands = {
        "list": ["ls", "-l"],
        "date": ["date"],
        "whoami": ["whoami"]
    }
    cmd = allowed_commands.get(user_input)
    if cmd:
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, check=True)
            print(result.stdout)
        except subprocess.CalledProcessError as e:
            print(f"Command failed: {e}", file=sys.stderr)
    else:
        print("Command not allowed.", file=sys.stderr)

def find_number(numbers, target):
    return target in numbers

def main():
    data = list(range(10000))

    result = calculate_sum(data)
    print("Sum:", result)

    user = input("Username: ")
    pwd = getpass("Password: ")

    if login(user, pwd):
        print("Logged in")
    else:
        print("Access denied")
        return

    cmd = input("Enter command: ")
    execute_command(cmd)

if __name__ == "__main__":
    main()